{
  "name": "whack-a-mole",
  "version": "1.0.0",
  "description": "Juego arcade Whack-a-Mole con dificultad progresiva y sistema de bombas",
  "main": "game.js",
  "scripts": {
    "start": "npx http-server -p 8080 -c-1",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:js": "eslint .",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "build": "npm run lint && npm run build:copy",
    "build:copy": "node scripts/build.js",
    "clean": "rm -rf dist coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelisam/whack-a-mole.git"
  },
  "keywords": [
    "game",
    "arcade",
    "whack-a-mole",
    "javascript",
    "html5"
  ],
  "author": "miguelisam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/miguelisam/whack-a-mole/issues"
  },
  "homepage": "https://miguelisam.github.io/whack-a-mole/",
  "devDependencies": {
    "eslint": "^8.57.0",
    "htmlhint": "^1.1.4",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
